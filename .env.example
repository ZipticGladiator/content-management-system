# Copy this to .env and fill in your Supabase project's values
# (Supabase dashboard → Project Settings → Database → Connection string).

# "Transaction" pooler connection (port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — used only for running migrations.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Shared passphrase gate for the whole app — set your own, share it with collaborators.
APP_PASSPHRASE="change-me"

# Random secret used to sign the login session cookie (e.g. `openssl rand -hex 32`).
AUTH_SECRET="change-me"

# Supabase Storage — used server-side only to upload attachments (thumbnails, reference files).
SUPABASE_URL="https://[project-ref].supabase.co"
# From Supabase dashboard → Project Settings → API → "service_role" secret. Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY="change-me"

# YouTube Studio Analytics — from Google Cloud Console (APIs & Services → Credentials).
YOUTUBE_CLIENT_ID="change-me"
YOUTUBE_CLIENT_SECRET="change-me"
# Used to build the OAuth redirect_uri; must exactly match an "Authorized redirect URI" on the OAuth client.
YOUTUBE_OAUTH_BASE_URL="http://localhost:3000"

# TikTok integration — from developers.tiktok.com (Manage apps → Login Kit).
TIKTOK_CLIENT_KEY="change-me"
TIKTOK_CLIENT_SECRET="change-me"
# Used to build the OAuth redirect_uri; must exactly match a redirect URI registered on the Login Kit product.
TIKTOK_OAUTH_BASE_URL="http://localhost:3000"
