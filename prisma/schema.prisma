// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  EDUCATIONAL
  TECHNICAL
  LIFESTYLE
}

enum YoutubeStatus {
  IDEA
  SCRIPT
  FILM
  EDIT
  SCHEDULED
  PUBLISHED
}

enum TiktokStatus {
  IDEA
  SCRIPT
  FILM
  EDIT
  POSTED
}

enum ScriptStatus {
  DRAFT
  FINAL
}

enum InspirationPlatform {
  YOUTUBE
  TIKTOK
  OTHER
}

enum GoalPlatform {
  YOUTUBE
  TIKTOK
}

enum InspirationType {
  COMPETITOR
  INSPIRATION
}

model YoutubeVideo {
  id        String        @id @default(cuid())
  title     String
  pitch     String        @default("")
  category  Category      @default(EDUCATIONAL)
  status    YoutubeStatus @default(IDEA)
  dueDate   DateTime?
  cost      Int           @default(0)
  paid      Boolean       @default(false)
  editor    String        @default("")
  url       String        @default("")
  topPick   Boolean       @default(false)

  stepScript    Boolean @default(false)
  stepFilm      Boolean @default(false)
  stepEdit      Boolean @default(false)
  stepThumbnail Boolean @default(false)
  stepUpload    Boolean @default(false)

  notes       String   @default("")
  script      Script?
  comments    Comment[]
  attachments Attachment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TiktokClip {
  id          String       @id @default(cuid())
  title       String
  pitch       String       @default("")
  category    Category     @default(EDUCATIONAL)
  status      TiktokStatus @default(IDEA)
  dueDate     DateTime?
  cost        Int          @default(0)
  paid        Boolean      @default(false)
  editor      String       @default("")
  url         String       @default("")
  notes       String       @default("")
  script      Script?
  comments    Comment[]
  attachments Attachment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Script {
  id     String       @id @default(cuid())
  body   String       @default("")
  status ScriptStatus @default(DRAFT)

  youtubeVideoId String?       @unique
  youtubeVideo   YoutubeVideo? @relation(fields: [youtubeVideoId], references: [id], onDelete: Cascade)

  tiktokClipId String?     @unique
  tiktokClip   TiktokClip? @relation(fields: [tiktokClipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id       String  @id @default(cuid())
  author   String
  body     String
  isSystem Boolean @default(false)

  youtubeVideoId String?       @map("youtube_video_id")
  youtubeVideo   YoutubeVideo? @relation(fields: [youtubeVideoId], references: [id], onDelete: Cascade)

  tiktokClipId String?     @map("tiktok_clip_id")
  tiktokClip   TiktokClip? @relation(fields: [tiktokClipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([youtubeVideoId])
  @@index([tiktokClipId])
}

model YoutubeAuth {
  id             String    @id @default(cuid())
  refreshToken   String
  accessToken    String?
  accessTokenExp DateTime?
  channelId      String?
  channelTitle   String?
  connectedEmail String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model TiktokAuth {
  id             String    @id @default(cuid())
  refreshToken   String
  accessToken    String?
  accessTokenExp DateTime?
  openId         String?
  displayName    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Attachment {
  id    String @id @default(cuid())
  label String @default("")
  url   String

  youtubeVideoId String?       @map("youtube_video_id")
  youtubeVideo   YoutubeVideo? @relation(fields: [youtubeVideoId], references: [id], onDelete: Cascade)

  tiktokClipId String?     @map("tiktok_clip_id")
  tiktokClip   TiktokClip? @relation(fields: [tiktokClipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([youtubeVideoId])
  @@index([tiktokClipId])
}

model Inspiration {
  id          String              @id @default(cuid())
  name        String
  platform    InspirationPlatform @default(YOUTUBE)
  type        InspirationType     @default(INSPIRATION)
  url         String              @default("")
  followers   Int                 @default(0)
  description String              @default("")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Goal {
  id            String         @id @default(cuid())
  platform      GoalPlatform
  label         String         @default("")
  target        Int
  manualCurrent Int            @default(0)
  deadline      DateTime?
  snapshots     GoalSnapshot[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model GoalSnapshot {
  id         String   @id @default(cuid())
  goalId     String
  goal       Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  value      Int
  capturedAt DateTime @default(now())

  @@index([goalId])
}

model Editor {
  id            String   @id @default(cuid())
  name          String
  email         String   @default("")
  rate          Int      @default(0)
  rateUnit      String   @default("per video")
  bankName      String   @default("")
  accountHolder String   @default("")
  accountNumber String   @default("")
  branchCode    String   @default("")
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
