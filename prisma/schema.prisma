// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  EDITOR
}

enum Plan {
  STARTER
  CREATOR_PRO
  AGENCY
}

/// A workspace: one subscription, one brand, one set of content. Every
/// content table below belongs to exactly one Organization — see
/// lib/org.ts, which is the one place that enforces it.
model Organization {
  id          String @id @default(cuid())
  name        String
  accentColor String @default("#ccff00")
  plan        Plan   @default(STARTER)

  // The plan's limits, copied onto the org when the plan changes (lib/plans.ts)
  // so a past downgrade/upgrade doesn't silently change what an org already had.
  seatLimit    Int @default(2)
  accountLimit Int @default(1)
  aiDraftLimit Int @default(20)

  stripeCustomerId     String?
  stripeSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  categories    Category[]
  invites       Invite[]
  youtubeVideos YoutubeVideo[]
  tiktokClips   TiktokClip[]
  scripts       Script[]
  comments      Comment[]
  attachments   Attachment[]
  assets        Asset[]
  editors       Editor[]
  inspirations  Inspiration[]
  goals         Goal[]
  youtubeAuths  YoutubeAuth[]
  tiktokAuths   TiktokAuth[]
  pushDevices   PushDevice[]
  aiDraftLogs   AiDraftLog[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  pushDevices PushDevice[]

  @@index([orgId])
}

/// A pending "join this org" link, since there's no transactional email
/// service wired up yet — the owner copies the link instead of it being
/// emailed automatically (lib/invites.ts).
model Invite {
  id            String    @id @default(cuid())
  email         String
  role          UserRole  @default(EDITOR)
  token         String    @unique
  invitedByName String
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// Replaces the old fixed Category enum: every org defines its own labels.
model Category {
  id        String   @id @default(cuid())
  key       String
  label     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@index([orgId])
}

/// One row per AI script draft generated, so "drafts used this month" is a
/// count, not a counter that can drift. lib/plans.ts reads it for the
/// billing page.
model AiDraftLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

/// A phone signed in to the mobile app that should receive push notifications.
/// `token` is its Expo push token; re-registering from another account moves it.
model PushDevice {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orgId])
}

enum YoutubeStatus {
  IDEA
  SCRIPT
  FILM
  EDIT
  SCHEDULED
  PUBLISHED
}

enum TiktokStatus {
  IDEA
  SCRIPT
  FILM
  EDIT
  POSTED
}

enum ScriptStatus {
  DRAFT
  FINAL
}

enum InspirationPlatform {
  YOUTUBE
  TIKTOK
  OTHER
}

enum GoalPlatform {
  YOUTUBE
  TIKTOK
}

enum InspirationType {
  COMPETITOR
  INSPIRATION
}

model YoutubeVideo {
  id        String        @id @default(cuid())
  title     String
  pitch     String        @default("")
  category  String        @default("")
  status    YoutubeStatus @default(IDEA)
  dueDate   DateTime?
  cost      Int           @default(0)
  paid      Boolean       @default(false)
  editor    String        @default("")
  url       String        @default("")
  topPick   Boolean       @default(false)
  deletedAt DateTime?

  stepScript    Boolean @default(false)
  stepFilm      Boolean @default(false)
  stepEdit      Boolean @default(false)
  stepThumbnail Boolean @default(false)
  stepUpload    Boolean @default(false)

  notes       String       @default("")
  script      Script?
  comments    Comment[]
  attachments Attachment[]
  assets      Asset[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([orgId])
}

model TiktokClip {
  id          String       @id @default(cuid())
  title       String
  pitch       String       @default("")
  category    String       @default("")
  status      TiktokStatus @default(IDEA)
  dueDate     DateTime?
  cost        Int          @default(0)
  paid        Boolean      @default(false)
  editor      String       @default("")
  url         String       @default("")
  notes       String       @default("")
  deletedAt   DateTime?
  script      Script?
  comments    Comment[]
  attachments Attachment[]
  assets      Asset[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([orgId])
}

model Script {
  id     String       @id @default(cuid())
  body   String       @default("")
  status ScriptStatus @default(DRAFT)

  youtubeVideoId String?       @unique
  youtubeVideo   YoutubeVideo? @relation(fields: [youtubeVideoId], references: [id], onDelete: Cascade)

  tiktokClipId String?     @unique
  tiktokClip   TiktokClip? @relation(fields: [tiktokClipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Comment {
  id       String  @id @default(cuid())
  author   String
  body     String
  isSystem Boolean @default(false)

  youtubeVideoId String?       @map("youtube_video_id")
  youtubeVideo   YoutubeVideo? @relation(fields: [youtubeVideoId], references: [id], onDelete: Cascade)

  tiktokClipId String?     @map("tiktok_clip_id")
  tiktokClip   TiktokClip? @relation(fields: [tiktokClipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([youtubeVideoId])
  @@index([tiktokClipId])
  @@index([orgId])
}

model YoutubeAuth {
  id             String    @id @default(cuid())
  refreshToken   String
  accessToken    String?
  accessTokenExp DateTime?
  channelId      String?
  channelTitle   String?
  connectedEmail String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model TiktokAuth {
  id             String    @id @default(cuid())
  refreshToken   String
  accessToken    String?
  accessTokenExp DateTime?
  openId         String?
  displayName    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Attachment {
  id    String @id @default(cuid())
  label String @default("")
  url   String

  youtubeVideoId String?       @map("youtube_video_id")
  youtubeVideo   YoutubeVideo? @relation(fields: [youtubeVideoId], references: [id], onDelete: Cascade)

  tiktokClipId String?     @map("tiktok_clip_id")
  tiktokClip   TiktokClip? @relation(fields: [tiktokClipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([youtubeVideoId])
  @@index([tiktokClipId])
  @@index([orgId])
}

model Inspiration {
  id          String              @id @default(cuid())
  name        String
  platform    InspirationPlatform @default(YOUTUBE)
  type        InspirationType     @default(INSPIRATION)
  url         String              @default("")
  followers   Int                 @default(0)
  description String              @default("")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Goal {
  id            String         @id @default(cuid())
  platform      GoalPlatform
  label         String         @default("")
  target        Int
  manualCurrent Int            @default(0)
  deadline      DateTime?
  snapshots     GoalSnapshot[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model GoalSnapshot {
  id         String   @id @default(cuid())
  goalId     String
  goal       Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  value      Int
  capturedAt DateTime @default(now())

  @@index([goalId])
}

model Editor {
  id            String   @id @default(cuid())
  name          String
  email         String   @default("")
  rate          Int      @default(0)
  rateUnit      String   @default("per video")
  bankName      String   @default("")
  accountHolder String   @default("")
  accountNumber String   @default("")
  branchCode    String   @default("")
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

enum AssetType {
  THUMBNAIL
  DOCUMENT
  VIDEO
  IMAGE
  AUDIO
  OTHER
}

/// A link to a file kept elsewhere (usually Google Drive): thumbnails, docs,
/// footage. The file itself isn't stored here. Optionally tied to one video or
/// clip; purging that item from Trash keeps the asset, just unlinked.
model Asset {
  id    String    @id @default(cuid())
  title String
  url   String
  type  AssetType @default(OTHER)
  notes String    @default("")

  youtubeVideoId String?       @map("youtube_video_id")
  youtubeVideo   YoutubeVideo? @relation(fields: [youtubeVideoId], references: [id], onDelete: SetNull)

  tiktokClipId String?     @map("tiktok_clip_id")
  tiktokClip   TiktokClip? @relation(fields: [tiktokClipId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([youtubeVideoId])
  @@index([tiktokClipId])
  @@index([orgId])
}
